{
  "name": "raath_pos",
  "version": "0.1.0",
  "private": true,
  "main": "public/electron.js",
  "homepage": "./",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/x-date-pickers": "^9.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "autoprefixer": "^10.5.0",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.1.0",
    "electron-store": "^11.0.2",
    "firebase": "^12.16.0",
    "googleapis": "^171.4.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "react-scripts": "5.0.1",
    "sqlite3": "^6.0.1",
    "tailwindcss": "^3.4.19",
    "tesseract.js": "^7.0.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "rebuild": "npm rebuild better-sqlite3 --runtime=electron --target=42.1.0 --disturl=https://electronjs.org/headers --abi=146",
    "postinstall": "npm run rebuild",
    "electron": "npx electron public/electron.js",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && npx electron public/electron.js\"",
    "copy-electron": "copy public\\electron.js build\\electron.js && copy public\\preload.js build\\preload.js",
    "electron-pack": "npm run build && npm run copy-electron && npx electron-builder --dir",
    "electron-dist": "npm run build && npm run copy-electron && npx electron-builder"
  },
  "build": {
    "appId": "com.raath.pos",
    "productName": "RAATH POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/better-sqlite3/build/Release",
        "to": "app/node_modules/better-sqlite3/build/Release"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.10"
  }
}
