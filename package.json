{
  "name": "raath_pos",
  "version": "2.0.0",
  "private": true,
  "main": "electron/main.js",
  "homepage": "./",
  "description": "RAATH POS - Point of Sale System",
  "author": "RAATH POS",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/x-date-pickers": "^9.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "autoprefixer": "^10.5.0",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.1.0",
    "electron-store": "^11.0.2",
    "firebase": "^12.16.0",
    "googleapis": "^171.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "react-scripts": "5.0.1",
    "recharts": "^3.10.1",
    "sqlite3": "^6.0.1",
    "tailwindcss": "^3.4.19",
    "tesseract.js": "^7.0.0",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "cross-env DISABLE_ESLINT_PLUGIN=true react-scripts start",
   
  "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 DISABLE_ESLINT_PLUGIN=true react-scripts build",

    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "rebuild": "npm rebuild better-sqlite3 --runtime=electron --target=42.1.0 --disturl=https://electronjs.org/headers --abi=146",
    "postinstall": "npm run rebuild",
    "electron": "npx electron electron/main.js",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && npx electron electron/main.js\"",
    "copy-preload": "node -e \"require('fs').copyFileSync('public/preload.js', 'build/preload.js')\"",
    "pre-electron-pack": "npm run build && npm run copy-preload",
    "electron-pack": "npm run pre-electron-pack && npx electron-builder --dir",
    "electron-dist": "npm run pre-electron-pack && npx electron-builder",
    "dist": "npm run pre-electron-pack && npx electron-builder --win",
    "dist-mac": "npm run pre-electron-pack && npx electron-builder --mac",
    "dist-linux": "npm run pre-electron-pack && npx electron-builder --linux"
  },
  "build": {
    "appId": "com.raath.pos",
    "productName": "RAATH POS",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "public/electron.js",
      "!electron/**/*.test.js",
      "!electron/**/*.spec.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/better-sqlite3/build/Release/",
        "to": "better-sqlite3-native/",
        "filter": [
          "**/*.node",
          "**/*.dll",
          "**/*.so",
          "**/*.dylib"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*.node",
      "**/node_modules/sqlite3/**/*.node"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RAATH POS"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "public/favicon.icns",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "icon": "public/favicon.png"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^42.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-jest": "^27.6.0",
    "wait-on": "^9.0.10"
  },
  "eslintConfig": {
    "extends": ["react-app"],
    "rules": {
      "no-unused-vars": "warn"
    }
  }
}